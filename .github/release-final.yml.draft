# PRODUCTION release workflow. Not executed here: it lives outside .github/workflows.
# Replaces .github/workflows/release.yml (the rehearsal) with this file, in one commit.
# The push of that commit is the first real release run.
name: Release

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      incrementer:
        description: Which part of the version to increment
        type: choice
        options: [patch, minor, major]
        default: patch

# V-8: one run at a time. A queued run is replaced by a newer queued one, so the owner compares the
# computed version in the publish summary at approval time and re-dispatches if it is not the intended one.
concurrency:
  group: release
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  # V-1: the only writer of the version. axion-release computes it WITHOUT creating any tag.
  # V-2: only the remote is inspected.
  guard:
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.v.outputs.version }}
      sha: ${{ steps.v.outputs.sha }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - uses: gradle/actions/setup-gradle@v4
      - name: Compute the release version
        id: v
        env:
          INCREMENTER: ${{ inputs.incrementer || 'patch' }}
        run: |
          source scripts/lib.sh
          [ "$GITHUB_REF" = "refs/heads/main" ] || { echo "release only from main, got $GITHUB_REF"; exit 1; }
          git fetch --tags --force
          case "$INCREMENTER" in
            patch) inc=incrementPatch ;;
            minor) inc=incrementMinor ;;
            major) inc=incrementMajor ;;
            *) echo "unknown incrementer: $INCREMENTER"; exit 1 ;;
          esac
          # currentVersion only reads: no tag is created. The root build configures axion without SNAPSHOT/branch
          # decoration, so on an untagged HEAD it answers the plain next release number X.Y.Z.
          raw=$(./gradlew -q --console=plain currentVersion -Prelease.quiet "-Prelease.versionIncrementer=$inc" | tail -n 1)
          echo "axion answered: $raw"
          version="$raw"
          require_release_semver "$version"
          scripts/verify.sh "$version" absent
          echo "version=$version" >> "$GITHUB_OUTPUT"
          echo "sha=$GITHUB_SHA" >> "$GITHUB_OUTPUT"
          echo "### Release $version ($INCREMENTER) from $GITHUB_SHA" >> "$GITHUB_STEP_SUMMARY"

  ci:
    needs: guard
    permissions:
      contents: read
    uses: ./.github/workflows/ci.yml
    with:
      version: ${{ needs.guard.outputs.version }}

  # The only job that sees secrets; approval of the environment is the human gate.
  publish:
    needs: [guard, ci]
    runs-on: ubuntu-latest
    environment: central
    permissions:
      contents: read
    env:
      VERSION: ${{ needs.guard.outputs.version }}
      # Release mode: publish automatically; Gradle waits for PUBLISHED.
      ORG_GRADLE_PROJECT_mavenCentralAutomaticPublishing: 'true'
      ORG_GRADLE_PROJECT_mavenCentralDeploymentValidation: PUBLISHED
      ORG_GRADLE_PROJECT_mavenCentralUsername: ${{ secrets.MAVEN_CENTRAL_USERNAME }}
      ORG_GRADLE_PROJECT_mavenCentralPassword: ${{ secrets.MAVEN_CENTRAL_PASSWORD }}
      ORG_GRADLE_PROJECT_signingInMemoryKey: ${{ secrets.SIGNING_KEY }}
      ORG_GRADLE_PROJECT_signingInMemoryKeyPassword: ${{ secrets.SIGNING_KEY_PASSWORD }}
    steps:
      # actions/checkout v4.3.1
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          fetch-depth: 0
      # actions/setup-java v4.9.1
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3
        with:
          distribution: temurin
          java-version: '21'
      - name: Publish
        run: ./gradlew publishToMavenCentral "-Prelease.forceVersion=$VERSION" "-Pmurmuration.buildSha=$GITHUB_SHA" --console=plain

  verify:
    needs: [guard, publish]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Wait for the files on Maven Central
        run: scripts/verify.sh "${{ needs.guard.outputs.version }}" present

  # V-4: idempotent; re-running a failed verify or tag is safe.
  tag:
    needs: [guard, verify]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.guard.outputs.sha }}
          fetch-depth: 0
      - name: Tag and create the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: scripts/tag.sh "${{ needs.guard.outputs.version }}" "${{ needs.guard.outputs.sha }}"
